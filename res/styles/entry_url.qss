QFrame {
    margin: 5px;
    padding: 0;
    border-radius: 5px;
    background-color: #141618;
    width: 100px;
    height: 2rem;
}

QFrame:hover,
QFrame:active {
    border: 1px solid #6a52a4;
}

QLineEdit,
QPushButton,
QLineEdit:focus,
QPushButton:focus {
    border: none;
    margin: 0;
    outline: none;
}

QLineEdit:read-only,
QPushButton:disabled {
    color: gray;
}

QPushButton:hover {
    color: #6a52a4;
}